{
  "name": "@avala-ai/mcp-server",
  "version": "0.7.4",
  "description": "MCP server for the Avala API",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avala-ai/avala-sdk-ts.git",
    "directory": "packages/mcp-server"
  },
  "main": "./dist/index.js",
  "bin": {
    "avala-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --project ../sdk/tsconfig.json --emitDeclarationOnly && tsc --noEmit && tsc --project scripts/tsconfig.json && tsc --project eval/tsconfig.json",
    "docs:generate": "bun scripts/generate-mcp-docs.ts",
    "docs:check": "bun scripts/generate-mcp-docs.ts --check",
    "docs:list": "bun scripts/generate-mcp-docs.ts --list",
    "eval": "bun eval/runner.ts",
    "eval:record": "bun eval/runner.ts --live --trials 1 --concurrency 1"
  },
  "dependencies": {
    "@avala-ai/sdk": "workspace:*",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.2.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^25.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
